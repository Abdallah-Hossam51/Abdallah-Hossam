{{ 'custom-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-banner.js' | asset_url }}" defer></script>

<section
  class="custom-banner"
  {% if section.settings.background_image != blank %}
    style="background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');"
  {% endif %}
>

  <div class="banner-overlay">

    <header class="banner-header">

      <div class="banner-logo">
        {{ section.settings.logo_text }}
      </div>

      <div class="banner-top-text">
        {{ section.settings.top_text }}
      </div>

      <a href="#" class="banner-btn banner-btn--outline">
        {{ section.settings.button_text }}
      </a>

    </header>

    <div class="banner-content">

      <h1 class="banner-title">
        {{ section.settings.heading }}
      </h1>

      <p class="banner-description">
        {{ section.settings.description }}
      </p>

      <a href="#" class="banner-btn banner-btn--filled">
        {{ section.settings.shop_button }}
      </a>

    </div>

    <div class="banner-strip">
      {{ section.settings.bottom_text }}
    </div>

  </div>

</section>
{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo",
      "default": "TISSO VISION"
    },
    {
      "type": "text",
      "id": "top_text",
      "label": "Top Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Top Button",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "shop_button",
      "label": "Shop Button",
      "default": "SHOP NOW"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}