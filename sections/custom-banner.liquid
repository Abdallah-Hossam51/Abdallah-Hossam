{{ 'custom-banner.css' | asset_url | stylesheet_tag }}

{% if section.settings.background_image %}
  {% assign has_bg_image = true %}
{% endif %}

<section
  class="custom-banner"
  data-section-id="{{ section.id }}"
  data-section-type="custom-banner"
>

  {%- if section.settings.logo_text != blank or section.settings.top_bar_text != blank or section.settings.top_bar_button_text != blank -%}
    <div class="custom-banner__topbar">
      <div class="custom-banner__topbar-inner">
        <button
          type="button"
          class="custom-banner__menu-toggle"
          aria-label="Menu"
          aria-expanded="false"
        >
          <svg width="20" height="14" viewBox="0 0 20 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M0 1H20M0 7H20M0 13H20" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </button>

        {%- if section.settings.logo_text != blank -%}
          <a href="{{ routes.root_url }}" class="custom-banner__logo">{{ section.settings.logo_text }}</a>
        {%- endif -%}

        {%- if section.settings.top_bar_text != blank -%}
          <p class="custom-banner__topbar-text">{{ section.settings.top_bar_text }}</p>
        {%- endif -%}

        {%- if section.settings.top_bar_button_text != blank -%}
          <a
            href="{{ section.settings.top_bar_button_link | default: '#' }}"
            class="custom-banner__btn custom-banner__btn--pill"
          >
            <span class="custom-banner__btn-label">{{ section.settings.top_bar_button_text }}</span>
            <span class="custom-banner__btn-arrow" aria-hidden="true">
              <svg width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 5H15M15 5L11 1M15 5L11 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="custom-banner__hero{% if has_bg_image %} custom-banner__hero--has-image{% endif %}">
    {%- if has_bg_image -%}
      <div class="custom-banner__image-wrap">
        {{
          section.settings.background_image
          | image_url: width: 2000
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '750, 1100, 1500, 2000',
            class: 'custom-banner__image'
        }}
      </div>
    {%- endif -%}

    <div class="custom-banner__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="custom-banner__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.sub_heading != blank -%}
        <p class="custom-banner__subheading">{{ section.settings.sub_heading }}</p>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="custom-banner__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <div class="custom-banner__hero-btn">
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="custom-banner__btn custom-banner__btn--primary"
          >
            <span class="custom-banner__btn-label">{{ section.settings.button_text }}</span>
            <span class="custom-banner__btn-arrow" aria-hidden="true">
              <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 6H17M17 6L12 1M17 6L12 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.bottom_bar_text != blank -%}
    <div class="custom-banner__bottombar">
      <p class="custom-banner__bottombar-text">{{ section.settings.bottom_bar_text }}</p>
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "section-custom-banner",
  "settings": [
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_bar_text",
      "label": "Top bar announcement text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_bar_button_text",
      "label": "Top bar button text",
      "default": "Choose gift"
    },
    {
      "type": "url",
      "id": "top_bar_button_link",
      "label": "Top bar button link"
    },
    {
      "type": "header",
      "content": "Hero content"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub heading",
      "default": "Holiday Collection"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "bottom_bar_text",
      "label": "Bottom bar text",
      "default": "Sustainable, ethically made clothes in sizes XXS to 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
