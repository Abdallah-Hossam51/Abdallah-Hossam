{{ 'custom-product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-product-grid.js' | asset_url }}" defer></script>

<section class="custom-product-grid">

  <div class="page-width">

    <h2 class="grid-heading">{{ section.settings.heading }}</h2>

    <div class="grid-container">

      {% assign p1 = section.settings.product_1 %}
      {% if p1 %}
      <div class="product-card" data-handle="{{ p1.handle }}">
        <div class="product-image">
          {{ p1.featured_image | image_url: width: 700 | image_tag }}
          <button class="product-popup-btn" data-handle="{{ p1.handle }}">+</button>
        </div>
      </div>
      {% endif %}

      {% assign p2 = section.settings.product_2 %}
      {% if p2 %}
      <div class="product-card" data-handle="{{ p2.handle }}">
        <div class="product-image">
          {{ p2.featured_image | image_url: width: 700 | image_tag }}
          <button class="product-popup-btn" data-handle="{{ p2.handle }}">+</button>
        </div>
      </div>
      {% endif %}

      {% assign p3 = section.settings.product_3 %}
      {% if p3 %}
      <div class="product-card" data-handle="{{ p3.handle }}">
        <div class="product-image">
          {{ p3.featured_image | image_url: width: 700 | image_tag }}
          <button class="product-popup-btn" data-handle="{{ p3.handle }}">+</button>
        </div>
      </div>
      {% endif %}

      {% assign p4 = section.settings.product_4 %}
      {% if p4 %}
      <div class="product-card" data-handle="{{ p4.handle }}">
        <div class="product-image">
          {{ p4.featured_image | image_url: width: 700 | image_tag }}
          <button class="product-popup-btn" data-handle="{{ p4.handle }}">+</button>
        </div>
      </div>
      {% endif %}

      {% assign p5 = section.settings.product_5 %}
      {% if p5 %}
      <div class="product-card" data-handle="{{ p5.handle }}">
        <div class="product-image">
          {{ p5.featured_image | image_url: width: 700 | image_tag }}
          <button class="product-popup-btn" data-handle="{{ p5.handle }}">+</button>
        </div>
      </div>
      {% endif %}

      {% assign p6 = section.settings.product_6 %}
      {% if p6 %}
      <div class="product-card" data-handle="{{ p6.handle }}">
        <div class="product-image">
          {{ p6.featured_image | image_url: width: 700 | image_tag }}
          <button class="product-popup-btn" data-handle="{{ p6.handle }}">+</button>
        </div>
      </div>
      {% endif %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}