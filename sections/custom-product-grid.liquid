{{ 'custom-product-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign special_handle = ''
  if section.settings.special_product != blank
    assign special_handle = section.settings.special_product.handle
  endif
-%}

<section
  class="custom-product-grid"
  id="CustomProductGrid-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="custom-product-grid"
  data-special-product-handle="{{ special_handle }}"
>

  {%- if section.settings.heading != blank -%}
    <div class="custom-product-grid__header">
      <h2 class="custom-product-grid__heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="custom-product-grid__grid" data-product-grid>
    {%- for block in section.blocks -%}
      {%- if block.type == 'product' -%}
        {%- assign block_product = block.settings.product -%}
        <div class="custom-product-grid__card" {{ block.shopify_attributes }}>
          {%- if block_product != blank -%}
            <div class="custom-product-grid__image-wrap">
              {%- if block_product.featured_image != blank -%}
                {{
                  block_product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    widths: '400, 600, 900',
                    class: 'custom-product-grid__image'
                }}
              {%- else -%}
                <div class="custom-product-grid__image custom-product-grid__image--placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'custom-product-grid__placeholder-svg' }}
                </div>
              {%- endif -%}

              <button
                type="button"
                class="custom-product-grid__plus"
                data-product-handle="{{ block_product.handle }}"
                aria-haspopup="dialog"
                aria-controls="CustomProductModal-{{ section.id }}"
                aria-label="Quick view {{ block_product.title | escape }}"
                style="left: {{ block.settings.hotspot_x }}%; top: {{ block.settings.hotspot_y }}%; transform: translate(-50%, -50%);"
              >
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M9 1V17M1 9H17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
          {%- else -%}
            <div class="custom-product-grid__image-wrap custom-product-grid__image-wrap--empty">
              <div class="custom-product-grid__image custom-product-grid__image--placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'custom-product-grid__placeholder-svg' }}
              </div>
              <p class="custom-product-grid__empty-label">Select a product</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div
    class="custom-product-modal"
    id="CustomProductModal-{{ section.id }}"
    data-product-modal
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    hidden
  >
    <div class="custom-product-modal__overlay" data-modal-close></div>

    <div class="custom-product-modal__dialog" role="document">
      <button type="button" class="custom-product-modal__close" data-modal-close aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M1 1L15 15M15 1L1 15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </button>

      <div class="custom-product-modal__body" data-modal-body>
        <div class="custom-product-modal__loading" data-modal-loading>Loading&hellip;</div>

        <div class="custom-product-modal__content" data-modal-content hidden>
          <div class="custom-product-modal__top">
            <div class="custom-product-modal__media">
              <img
                class="custom-product-modal__image"
                data-modal-image
                src=""
                alt=""
                width="400"
                height="400"
              >
            </div>

            <div class="custom-product-modal__info">
              <h3 class="custom-product-modal__title" data-modal-title></h3>
              <p class="custom-product-modal__price" data-modal-price></p>
              <div class="custom-product-modal__description" data-modal-description></div>
            </div>
          </div>

          <div class="custom-product-modal__options" data-modal-options></div>

          <p class="custom-product-modal__error" data-modal-error hidden></p>

          <button
            type="button"
            class="custom-product-modal__add-btn"
            data-add-to-cart
            disabled
          >
            <span data-add-to-cart-label>Add to cart</span>
            <span class="custom-product-modal__add-arrow" aria-hidden="true">
              <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 6H17M17 6L12 1M17 6L12 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

</section>

<script src="{{ 'custom-product-grid.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Custom Product Grid",
  "tag": "section",
  "class": "section-custom-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "product",
      "id": "special_product",
      "label": "Auto-add product",
      "info": "When a shopper adds any product with a Black + Medium variant selected, this product's Black + Medium variant is added automatically. If left blank, the section looks for a product at the handle \"dark-winter-jacket\"."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot X position (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 85,
          "info": "Horizontal position of the + button on the product image."
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot Y position (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "info": "Vertical position of the + button on the product image."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Custom Product Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
